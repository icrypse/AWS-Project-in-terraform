# Local .terraform directories
.terraform/

# Terraform state files (sensitive info)
terraform.tfstate
terraform.tfstate.backup

# Crash log files
crash.log

# Ignore override files that are local to each environment
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Ignore terraform plan output files
*.tfplan

# Ignore sensitive variable files
*.tfvars
*.tfvars.json
